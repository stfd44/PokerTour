rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function allowedNonCreatorFieldsChanged() {
      // Checks that the only fields being modified are 'games' and/or 'registrations'.
      // All other fields must remain identical.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'registrations']);
    }

    function allowedTournamentEnding() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        resource.data.status != 'ended' &&
        request.resource.data.status == 'ended';
    }

    // --- Rules ---
    match /teams/{teamId} {
      allow create: if isAuth();
      allow read: if isAuth();
      // Structures can be managed by group members; preserve other team actions.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        (request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blindPresets'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pastMembers']) &&
          request.auth.uid != resource.data.creatorId &&
          request.resource.data.members is list && request.resource.data.pastMembers is list &&
          request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid]) &&
          resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid]) &&
          request.resource.data.pastMembers.toSet().difference(resource.data.pastMembers.toSet()).hasOnly([request.auth.uid]) &&
          resource.data.pastMembers.toSet().difference(request.resource.data.pastMembers.toSet()).hasOnly([request.auth.uid]))
      );
      allow delete: if isUser(resource.data.creatorId);
    }

    match /tournaments/{tournamentId} {
      allow create: if isAuth();
      allow read: if true; // Anyone can read tournament details

      allow update: if isAuth() && (
        // Rule 1: The creator can always update the tournament.
        isUser(resource.data.creatorId) ||
        // Rule 2: Any authenticated user can modify ONLY the 'games' and/or 'registrations' array.
        // This keeps tournament metadata protected while allowing synced game actions and registrations.
        allowedNonCreatorFieldsChanged() ||
        // Rule 3: Any authenticated user can only mark a tournament as ended.
        allowedTournamentEnding()
      );
      
      allow delete: if isUser(resource.data.creatorId);
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create, update: if isUser(userId);

      match /devices/{deviceId} {
        allow read, create, update, delete: if isUser(userId);
      }
    }
  }
}
